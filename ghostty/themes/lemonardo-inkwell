# The selection is non-photo blue, at the lightness that keeps the
# foreground readable through it -- gated above, not assumed.
selection-background = #004553
selection-foreground = #ede4d3

# cell-background keeps the block cursor an inverse of whatever cell it
# lands on, so it stays visible over any slot above; cursor-text is the
# ground, which is what an inverted cell becomes.
cursor-color = cell-background
cursor-text = #2c2a28

# Split chrome: the divider is an ink wash, the unfocused fill a
# vermilion one, both far enough down in chroma to stay furniture.
split-divider-color = #44484e
unfocused-split-fill = #34211d

# palette-generate fills 16-255 from the sixteen above rather than
# leaving ghostty's defaults, which belong to neither design language.
palette-generate = true

# NO background-image. Midori's glow is drawn by Midori's shader, not by
# an image, and Lemonardo's shader draws no glow and no lattice; putting
# Midori's ground under Lemonardo's ink is the one thing a second design
# language must not do.
