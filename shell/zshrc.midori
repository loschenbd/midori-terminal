# Terminal theme — shell fragment, shared by BOTH design languages
# Sourced from ~/.zshrc by midori-terminal/install.sh. Everything here speaks
# ANSI-16 color names/indices, so it retints automatically when the Ghostty
# theme pair flips with macOS appearance — and, for the same reason, when the
# pair is swapped from midori-paper/midori-night to lemonardo-paintpot/
# lemonardo-inkwell. That is why this file has no `zshrc.lemonardo` twin: it
# holds no colour VALUE to port, only slot names and indices. The one thing it
# does name is a prompt file, and MIDORI_PROMPT below is how that is switched.

# Re-entrancy guard: makes a second source a no-op so the precmd hook and
# oh-my-posh init below aren't registered twice (double prompt render / double
# OSC 112) when a config re-sources this fragment.
[ -n "$_MIDORI_ZSHRC_SOURCED" ] && return
_MIDORI_ZSHRC_SOURCED=1

# Homebrew on PATH for a second account on the same Mac. /etc/paths lists
# /usr/local/bin but not /opt/homebrew/bin (checked Sept 2026, Darwin 25.6), so
# only a `brew shellenv` line in an account's own profile puts Apple-silicon
# Homebrew on PATH, and nothing adds one for an account that didn't install it.
# Without it every `command -v` below misses the shared tools: no oh-my-posh
# prompt, no eza, no zoxide, and tmux/herdr "not found". Prepended only when
# brew is absent, so a profile that already sets PATH keeps its own order.
# install.sh does the same for its own run (step 1).
if (( ! $+commands[brew] )) && [[ -x /opt/homebrew/bin/brew ]]; then
  path=(/opt/homebrew/bin /opt/homebrew/sbin $path)
fi

# Truecolor for Claude Code inside tmux. TWO env vars are required — one alone
# does nothing:
#   1. COLORTERM=truecolor — chalk/supports-color (which Claude's diff renderer
#      uses) reads COLORTERM, not terminfo; with TERM=tmux-256color and no
#      COLORTERM it caps at 256-color. This raises chalk's level to 24-bit.
#   2. CLAUDE_CODE_TMUX_TRUECOLOR=1 — Claude Code has a DELIBERATE clamp (added
#      v2.1.77, upstream issue #35148, verified in 2.1.210's binary):
#        if(env.CLAUDE_CODE_TMUX_TRUECOLOR) return;         // escape hatch
#        if(env.TMUX && chalk.level>2) chalk.level=2;       // force 256
#      It runs AFTER COLORTERM detection and knocks the level back to 256 unless
#      this var is set. So COLORTERM alone is silently undone; the escape hatch
#      alone has nothing to protect (level is already 256). Both together give
#      exact Midori washes (verified: bands emit 48;2;221;199;183 not 48;5;180).
# Undocumented var; must be exported from the shell (the clamp reads it at
# module load, before settings.json env injection).
if [ -n "$TMUX" ]; then
  export COLORTERM=truecolor
  export CLAUDE_CODE_TMUX_TRUECOLOR=1
fi

# Manuscript-style prompt: underlined path, middle-dot separators, plain
# foreground colors only (no filled powerline blocks).
#
# THE ONE DESIGN-LANGUAGE SWITCH IN THIS FILE, and it now follows the rest of
# the system instead of being set by hand. ~/.config/midori/language holds the
# chosen language; `midori-theme <lang>` writes it along with every other
# surface. This file reads it, so the prompt switches with everything else and
# there is nothing per-shell to remember.
#
# The precedence is deliberate: an explicit MIDORI_PROMPT in the environment
# still wins, so a single shell can run the other prompt without moving the
# whole machine — which is the one thing the language file cannot express.
# Setting MIDORI_PROMPT in ~/.zshrc still works too, and still has to come
# BEFORE the line that sources this fragment.
#
# install.sh overwrites this file, so an edit HERE would not survive the next
# run. That is why neither the language nor the override lives in this file:
# both are read, never stored.
#
# The two prompts are not interchangeable in one respect: midori.omp.json pins
# 24-bit hex and lemonardo.omp.json names ANSI slots, for reasons recorded in
# t3/README.md and in lemonardo.omp.json's own header. Inside t3 specifically,
# slot names are unreadable on a light ground.
if [ -z "$MIDORI_PROMPT" ] && [ -r "$HOME/.config/midori/language" ]; then
  MIDORI_PROMPT=$(cat "$HOME/.config/midori/language")
fi
: "${MIDORI_PROMPT:=midori}"
if command -v oh-my-posh >/dev/null 2>&1; then
  _midori_omp="$HOME/.config/${MIDORI_PROMPT}.omp.json"
  # Fall back rather than render oh-my-posh's default prompt, which is what a
  # missing --config gets you: a typo in MIDORI_PROMPT would otherwise replace
  # the whole prompt silently.
  if [ ! -f "$_midori_omp" ]; then
    echo "zshrc.midori: no $_midori_omp — falling back to midori.omp.json" >&2
    _midori_omp="$HOME/.config/midori.omp.json"
  fi
  eval "$(oh-my-posh init zsh --config "$_midori_omp")"
fi

# fzf on the terminal's own 16-color palette (correct in both modes).
export FZF_DEFAULT_OPTS="--color=16,fg:-1,bg:-1,gutter:-1,hl:4,fg+:-1,bg+:-1,hl+:12,prompt:2,pointer:1,marker:3,spinner:6,info:8,header:8,border:8"

# Reset the cursor color to the theme's (OSC 112) before every prompt —
# full-screen apps (Claude Code among them) set their own cursor color via
# OSC 12 and can leave it behind on exit, turning the indigo cursor dark.
# Safe only because the Ghostty themes set cursor-color = cell-background. On
# Ghostty 1.3.1 OSC 112 COPIES the current default cursor colour into the
# override instead of clearing it, and a light/dark flip never touches the
# override: while the themes used a background-hex sentinel, this hook pinned
# that mode's hex until the next prompt — and a full-screen app launched from
# the prompt (herdr) kept it for its whole life, drawing a black hollow cursor
# box in paper mode. See ghostty/themes/midori-paper.
_midori_cursor_reset() { printf '\e]112\a'; }
precmd_functions+=(_midori_cursor_reset)

# eza: iconed, dir-first listings. Colors ride the terminal's ANSI-16
# palette, so they retint with the light/dark flip like everything else.
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons=auto --group-directories-first'
  alias ll='eza -lh --icons=auto --group-directories-first --git'
  alias la='eza -lah --icons=auto --group-directories-first --git'
  alias tree='eza --tree --icons=auto --git-ignore'
fi

# zsh niceties without an oh-my-zsh dependency: autosuggestions + syntax
# highlighting from brew, skipped when a plugin manager already loaded them.
# (syntax-highlighting must be sourced last — this fragment is appended to
# the end of .zshrc, which satisfies that.)
_midori_bp="${HOMEBREW_PREFIX:-/opt/homebrew}"
[ -d "$_midori_bp" ] || _midori_bp=/usr/local
if ! typeset -f _zsh_autosuggest_start >/dev/null; then
  [ -f "$_midori_bp/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ] && \
    source "$_midori_bp/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi
if ! typeset -f _zsh_highlight >/dev/null; then
  [ -f "$_midori_bp/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ] && \
    source "$_midori_bp/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
unset _midori_bp

# zoxide: `z foo` jumps to the most-used directory matching "foo".
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# Midori Claude Code patch (inline code + tips) — self-heal after any Claude Code
# update. Those two render paths ignore the theme file, so we patch the binary
# (tools/apply-claude-midori-patch.sh). Updates (the native installer's updater,
# or a brew upgrade) restore the stock binary AND retarget the versioned path, so
# when the resolved path differs from the last-patched one, re-apply — only at
# launch, only after an update. (This used to need node/npx on PATH for tweakcc;
# the current patch needs python3 and codesign.)
if [ -f "$HOME/.config/midori/apply-claude-midori-patch.sh" ]; then
  claude() {
    # `whence -p`, NOT `command -v`: we are INSIDE a function named claude, and
    # zsh's `command -v claude` resolves the function first and prints the bare
    # word "claude". readlink of that is empty, `real` is empty, the guard below
    # short-circuits, and the self-heal silently never runs — which is exactly
    # how three Claude Code updates shipped unpatched. `whence -p` forces a PATH
    # search and skips the function.
    local real; real="$(readlink -f "$(whence -p claude 2>/dev/null)" 2>/dev/null)"
    if [ -n "$real" ] && [ "$real" != "$(cat "$HOME/.config/midori/claude-patched-path" 2>/dev/null)" ]; then
      sh "$HOME/.config/midori/apply-claude-midori-patch.sh" --auto || true
    fi
    command claude "$@"
  }
fi
