{
  "name": "midori-theme",
  "displayName": "Midori",
  "description": "Cream paper light and warm charcoal night, from benjaminloschen.com. Contrast tuned for non-retina 1x rendering. Matching file icons, workbench icons and markdown preview.",
  "version": "1.21.0",
  "publisher": "benjaminloschen",
  "license": "MIT",
  "homepage": "https://github.com/loschenbd/midori-terminal#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/loschenbd/midori-terminal.git"
  },
  "bugs": {
    "url": "https://github.com/loschenbd/midori-terminal/issues"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#f3f1eb",
    "theme": "light"
  },
  "keywords": [
    "theme",
    "light theme",
    "dark theme",
    "warm",
    "cream",
    "paper",
    "low contrast",
    "accessibility",
    "icon theme",
    "markdown"
  ],
  "categories": [
    "Themes"
  ],
  "engines": {
    "vscode": "^1.60.0"
  },
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "themes": [
      {
        "label": "Midori Paper",
        "uiTheme": "vs",
        "path": "./themes/midori-paper-color-theme.json"
      },
      {
        "label": "Midori Night",
        "uiTheme": "vs-dark",
        "path": "./themes/midori-night-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "midori-icons",
        "label": "Midori Icons",
        "path": "./icons/midori-icon-theme.json"
      }
    ],
    "productIconThemes": [
      {
        "id": "midori-product-icons",
        "label": "Midori Product Icons",
        "path": "./product-icons/midori-product-icon-theme.json"
      }
    ],
    "markdown.previewStyles": [
      "./markdown/midori-markdown.css"
    ],
    "markdown.markdownItPlugins": true,
    "grammars": [
      {
        "scopeName": "midori.injection.html-in-template",
        "path": "./syntaxes/midori-html-in-template.tmLanguage.json",
        "injectTo": [
          "source.ts",
          "source.tsx",
          "source.js",
          "source.js.jsx"
        ]
      }
    ]
  }
}
