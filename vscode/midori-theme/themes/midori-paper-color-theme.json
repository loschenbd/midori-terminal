  "tokenColors": [
    {
      "name": "Comment \u2014 derived quiet warm gray (ink washed into paper)",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#766e5f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String \u2014 midori-olive",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#586b3a"
      }
    },
    {
      "name": "Escapes & regex \u2014 dot-grid mint (deepened)",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#0b3c2f"
      }
    },
    {
      "name": "Numbers & constants \u2014 terracotta (accent-warm-strong)",
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "constant.other",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#773913"
      }
    },
    {
      "name": "Storage & declarations \u2014 midori-indigo, the resting rung",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#264464"
      }
    },
    {
      "name": "Control flow \u2014 extreme rung, extra chroma and real weight",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#175a98",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators & punctuation \u2014 muted ink",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#4c473f"
      }
    },
    {
      "name": "Functions \u2014 midori-ochre",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#906613"
      }
    },
    {
      "name": "Types & classes \u2014 midori-wine",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#744242"
      }
    },
    {
      "name": "Variables \u2014 ink",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#2a2825"
      }
    },
    {
      "name": "Parameters \u2014 eyebrow ink (accent-mythic), italic",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#625649",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties \u2014 derived plum (wine \u00d7 indigo)",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#786275"
      }
    },
    {
      "name": "this / self \u2014 plum italic",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#786275",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Decorators & annotations \u2014 plum",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#786275"
      }
    },
    {
      "name": "Tag names \u2014 indigo, the most chromatic of the three markup roles",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#00437a"
      }
    },
    {
      "name": "Tag brackets \u2014 dimmed from the name, as 82% of surveyed themes do",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#4c473f"
      }
    },
    {
      "name": "Attributes \u2014 ochre italic",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#906613",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS property names \u2014 muted ink",
      "scope": [
        "support.type.property-name.css",
        "support.type.vendored.property-name.css"
      ],
      "settings": {
        "foreground": "#4c473f"
      }
    },
    {
      "name": "JSON keys \u2014 indigo",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#264464"
      }
    },
    {
      "name": "Markdown heading \u2014 ink, bold",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#2a2825",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown heading / list punctuation \u2014 sage as punctuation",
      "scope": [
        "punctuation.definition.heading",
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#5f6f5e"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown quote \u2014 eyebrow ink italic",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#625649",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown inline code \u2014 warm deep",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#8f4f38"
      }
    },
    {
      "name": "Links \u2014 indigo",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#264464"
      }
    },
    {
      "name": "Diff / markup inserted \u2014 olive",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#586b3a"
      }
    },
    {
      "name": "Diff / markup deleted \u2014 warm deep",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#8f4f38"
      }
    },
    {
      "name": "Diff / markup changed \u2014 ochre",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#906613"
      }
    },
    {
      "name": "Diff headers \u2014 indigo",
      "scope": [
        "meta.diff.header",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#264464"
      }
    },
    {
      "name": "Invalid \u2014 warm deep (site alert color, not red)",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#8f4f38"
      }
    }
  ],
